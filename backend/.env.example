# Application Environment
ENVIRONMENT=development
PROJECT_NAME="StepCount Backend"
API_V1_STR=/api

# NeonDB PostgreSQL Connection String (uses asyncpg with SSL)
# Format: postgresql+asyncpg://<user>:<password>@<host>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEONDB_PASSWORD@ep-super-wildflower-axeau.us-east-2.aws.neon.tech/neondb?ssl=require

# Firebase Admin SDK Configuration
# Path to your downloaded service account JSON file from Firebase Console
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Optional: Raw JSON string for containerized / serverless deployments
# FIREBASE_CREDENTIALS_JSON=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["*"]
